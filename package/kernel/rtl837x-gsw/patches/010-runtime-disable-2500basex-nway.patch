+static bool serdes_2500basex_no_nway;
+module_param(serdes_2500basex_no_nway, bool, 0644);
+MODULE_PARM_DESC(serdes_2500basex_no_nway,
+		 "Disable NWay for SERDES_2500BASEX when the mode is applied");
+
+rtk_api_ret_t rtl837x_sds_mode_set(rtk_uint32 sds_index,
+				    rtk_sds_mode_t mode)
+{
+	rtk_api_ret_t ret;
+
+	ret = rtk_sdsMode_set(sds_index, mode);
+	if (ret == RT_ERR_OK && mode == SERDES_2500BASEX &&
+	    READ_ONCE(serdes_2500basex_no_nway))
+		sds_nway_set(sds_index, mode, DISABLED);
+
+	return ret;
+}
